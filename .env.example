# このファイルを .env にコピーして使います:  cp .env.example .env

# ---- アクセス設定 ----
# ブラウザからアクセスするポート番号（http://localhost:8081）
MAKASETA_PORT=8081
# 127.0.0.1 = このPCからだけアクセス可 / 0.0.0.0 = LAN内の他のPCからもアクセス可
MAKASETA_BIND=127.0.0.1
# ログインのパスワード。LAN など他のPCから使えるようにする場合は必ず設定してください（空ならログインなし）
MAKASETA_PASSWORD=

# ---- 資料室 ----
# 資料室として使うホストのフォルダ。直下のフォルダ1つが1つの資料室になります
LIBRARY_DIR=./library
# 「機密」にした資料室を読めるモデルのプロバイダ（カンマ区切り）
CONFIDENTIAL_PROVIDERS=bedrock

# ---- データベース ----
POSTGRES_PASSWORD=makaseta

# ---- AWS Bedrock ----
# ホストで aws configure 済みのフォルダ（読み取り専用でコンテナにマウントします）
AWS_CONFIG_DIR=~/.aws
AWS_PROFILE=default
AWS_REGION=us-east-1

# ---- Anthropic API（Claude を直接呼ぶ場合） ----
# https://console.anthropic.com で発行したAPIキー
ANTHROPIC_API_KEY=

# ---- 外部LLM（使うものだけ設定） ----
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# ---- モデル ----
# config/models.yaml に書いたプロファイル名
DEFAULT_MODEL_PROFILE=claude-main
EMBEDDING_MODEL_PROFILE=embed-main

# ---- コンテナ内ユーザー（ホストのユーザーIDに合わせる。通常は変更不要） ----
# MAKASETA_UID=1000
# MAKASETA_GID=1000

# ---- 上限 ----
# 同時に動ける社員の作業の数
MAX_CONCURRENT_RUNS=3
# 今月の利用料金がこの金額（米ドル）に達したら、新しい作業を止めます（0で無制限）
MONTHLY_BUDGET_USD=50
# 1回の作業で社員がモデルを呼べる回数
MAX_STEPS_PER_RUN=40
# レビューのたびに社員が振り返り、業務メモに学びを残す（false で無効）
AGENT_REFLECTION=true

# ---- スキルとサンドボックス ----
# true: サンドボックスはインターネットに接続できない（既定）/ false: 接続できる（uv や npm で追加インストールする場合）
SANDBOX_OFFLINE=true
SANDBOX_MEMORY=2g
SANDBOX_CPUS=2
# 非公開の GitHub リポジトリからスキルを取り込む場合のトークン（任意）
GITHUB_TOKEN=
