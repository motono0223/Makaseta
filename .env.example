# このファイルを .env にコピーして使います:  cp .env.example .env

# ---- アクセス設定 ----
# ブラウザからアクセスするポート番号（http://localhost:8081）
MAKASETA_PORT=8081
# 127.0.0.1 = このPCからだけアクセス可 / 0.0.0.0 = LAN内の他のPCからもアクセス可
MAKASETA_BIND=127.0.0.1

# ---- データベース ----
POSTGRES_PASSWORD=makaseta

# ---- AWS Bedrock ----
# ホストで aws configure 済みのフォルダ（読み取り専用でコンテナにマウントします）
AWS_CONFIG_DIR=~/.aws
AWS_PROFILE=default
AWS_REGION=us-east-1

# ---- 外部LLM（使うものだけ設定） ----
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# ---- モデル ----
# config/models.yaml に書いたプロファイル名
DEFAULT_MODEL_PROFILE=claude-main
EMBEDDING_MODEL_PROFILE=embed-main

# ---- コンテナ内ユーザー（ホストのユーザーIDに合わせる。通常は変更不要） ----
# MAKASETA_UID=1000
# MAKASETA_GID=1000
